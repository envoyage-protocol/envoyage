# Copy to .env.local. Never commit .env.local.
VITE_SUBGRAPH_URL=https://api.studio.thegraph.com/query/62788/envoyage/v0.0.4

# Gateway key for the Uniswap v4 subgraph on the decentralized network.
# Optional: without it the page still renders, just without the mainnet scale figure.
VITE_GRAPH_GATEWAY_KEY=

# Primary Sepolia RPC (Alchemy/Infura). Optional but strongly recommended: public
# operators rate-limit browsers, and 1rpc.io no longer serves Sepolia on its free
# tier at all — it answered with empty results and HTTP 200 for a day before saying so.
VITE_SEPOLIA_RPC_URL=
